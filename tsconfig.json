{
  "compilerOptions": {
    "target": "es2020",
    
    "module": "node16",
    "moduleResolution": "node16",
    
    "lib": ["es2022", "dom"],
    
    "strict": true,
    
    "esModuleInterop": true,
    "moduleDetection": "force",
    
    "declaration": false,
    "outDir": "out",
    
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
